# Copy to .env (`cp .env.example .env`). Docker Compose and the Makefile both read it.

# !!! PLACEHOLDER. Replace before `make up`, e.g.:
#     python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_before_use
JWT_EXPIRE_MINUTES=30
# bcrypt cost for new hashes AND the seeded users (cost is stored inside each hash, so after changing
# it re-run `make seed`). Each +1 doubles login CPU: 12 is ~4x the CPU of 10, and 20 users logging in
# at once on a 1-CPU API container then take seconds (see docs/INTEGRATION_LOG.md #5).
BCRYPT_ROUNDS=10

# Inside the compose network: the API goes through Toxiproxy, migrations go direct.
DATABASE_URL=postgresql+psycopg://pulseops:pulseops@toxiproxy:5433/pulseops
MIGRATION_DATABASE_URL=postgresql+psycopg://pulseops:pulseops@postgres:5432/pulseops
# From the host (seed, CLI, faults): direct to the published Postgres port.
HOST_DATABASE_URL=postgresql+psycopg://pulseops:pulseops@localhost:5432/pulseops

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=pulseops-api

DB_POOL_SIZE=5
DB_POOL_TIMEOUT=2
DB_STATEMENT_TIMEOUT_MS=3000

SEED_USERS=10000
SEED_PRODUCTS=2000
SEED_ORDERS=300000

PULSEOPS_API_URL=http://localhost:8000
PROMETHEUS_URL=http://localhost:9090
JAEGER_URL=http://localhost:16686
GRAFANA_URL=http://localhost:3000
TOXIPROXY_URL=http://localhost:8474
